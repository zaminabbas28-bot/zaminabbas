# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# decoded binary photos (stored as .b64 text, restored at build time)
public/images/*.jpg
!public/images/*.jpg.b64

# decoded binary videos + CV (stored as .b64 text, restored at build time)
public/videos/*.mp4
!public/videos/*.mp4.b64
public/videos/*.jpg
!public/videos/*.jpg.b64
public/Rana-Zamin-CV.pdf
!public/Rana-Zamin-CV.pdf.b64
